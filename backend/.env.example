# Persistent local SQLite file; relative paths resolve from backend/.
DATABASE_PATH="data/dhakapath.db"
PROJECT_NAME="DhakaPath Local API"
ENV="development"
DEBUG=True
API_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Optional intent parsing only. Leave disabled until a provider key is supplied.
LLM_PROVIDER="none"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=8
CHAT_SESSION_TTL_HOURS=24
