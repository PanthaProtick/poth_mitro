# Project Configuration
PROJECT_NAME="Hackathon Starter API"
ENV="development"
DEBUG=True
API_PREFIX="/api"

# Neon Serverless PostgreSQL Database Connection
# Format: postgresql+asyncpg://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql+asyncpg://neondb_owner:npg_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API Key
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Allowed CORS Origins (JSON list or comma separated)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
